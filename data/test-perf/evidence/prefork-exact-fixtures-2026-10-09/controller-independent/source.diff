+// These commands enter the public controller, not the generic conformance driver.
+fn group_controller_command(state: &ConformanceState, root: &Path) -> Command {
+    let mut command = driver_command(state);
+    command
+        .env_remove(DRIVER_MODE_ENV)
+        .env_remove(CONFORMANCE_MODE_ENV)
+        .env_remove(EXACT_FIXTURE_GROUP_ENV)
+        .env_remove(GROUP_FAILURE_ENV)
+        .env_remove(GROUP_TIMEOUT_ENV)
+        .env(GROUP_CONTROLLER_FIXTURE_ENV, "1")
+        .env(DRIVER_SETUP_MARKER_ENV, root)
+        .env("XDG_CACHE_HOME", root.join("cache"))
+        .env("WOW_SIM_ENABLE_BYTECODE_CACHE", "1");
+    command
+}
+
+fn group_setup_pid(root: &Path, group: &str) -> u32 {
+    let marker = std::fs::read_to_string(root.join(group)).expect("read sealed group setup marker");
+    let (pid, sealed) = marker
+        .trim()
+        .split_once(' ')
+        .expect("setup pid and sealing result");
+    assert_eq!(sealed, "sealed=0", "group must seal an empty bypass cache");
+    pid.parse().expect("parse setup process pid")
+}
+
+fn exact_group_selection(state: &ConformanceState) {
+    for group in CONTROLLER_GROUPS {
+        let name = format!("group-contract::{group}::pass");
+        let selected = TempDir::new().expect("create selection markers");
+        let output = group_controller_command(state, selected.path())
+            .args([&name, "--exact"])
+            .output()
+            .expect("run exact group selection");
+        assert_success(&output);
+        let text = stdout(&output);
+        assert_eq!(
+            text.lines()
+                .filter(|line| line.starts_with("test group-contract::"))
+                .collect::<Vec<_>>(),
+            vec![format!("test {name} ... ok")]
+        );
+        group_setup_pid(selected.path(), group);
+        for other in CONTROLLER_GROUPS.iter().filter(|other| *other != group) {
+            assert!(
+                !selected.path().join(other).exists(),
+                "unselected group {other} initialized"
+            );
+        }
+
+        for args in [
+            vec![name.as_str(), "--exact", "--skip", name.as_str()],
+            vec!["group-contract::unmatched", "--exact"],
+        ] {
+            let empty = TempDir::new().expect("create zero-selection markers");
+            let output = group_controller_command(state, empty.path())
+                .args(args)
+                .output()
+                .expect("run zero-selection group controller");
+            assert_success(&output);
+            assert_eq!(
+                stdout(&output).matches("running 0 tests").count(),
+                CONTROLLER_GROUPS.len() + 1
+            );
+            for group in CONTROLLER_GROUPS {
+                assert!(
+                    !empty.path().join(group).exists(),
+                    "zero selection initialized {group}"
+                );
+            }
+            assert!(
+                !empty.path().join("cache").exists(),
+                "zero selection initialized cache"
+            );
+        }
+    }
+}
+
+fn exact_group_failure(state: &ConformanceState) {
+    for failing in CONTROLLER_GROUPS {
+        let root = TempDir::new().expect("create failure markers");
+        let output = group_controller_command(state, root.path())
+            .args(["group-contract::", "--skip=::other", "--test-threads=1"])
+            .env(GROUP_FAILURE_ENV, failing)
+            .output()
+            .expect("run failing exact group controller");
+        assert_failure(&output);
+        let text = stdout(&output);
+        assert!(
+            text.contains(&format!(
+                "test group-contract::{failing}::pass ... FAILED (panic: deliberate panic text)"
+            )),
+            "{text}"
+        );
+        assert!(text.contains("child stdout marker"));
+        assert!(text.contains("child stderr marker"));
+        let mut pids = Vec::new();
+        for group in CONTROLLER_GROUPS {
+            pids.push(group_setup_pid(root.path(), group));
+            if group != failing {
+                assert!(
+                    text.contains(&format!("test group-contract::{group}::pass ... ok")),
+                    "later/sibling group missing: {text}"
+                );
+            }
+        }
+        pids.sort_unstable();
+        pids.dedup();
+        assert_eq!(
+            pids.len(),
+            CONTROLLER_GROUPS.len(),
+            "groups must use fresh processes"
+        );
+    }
+}
+
+fn exact_group_timeout(state: &ConformanceState) {
+    for group in CONTROLLER_GROUPS {
+        let root = TempDir::new().expect("create timeout markers");
+        let cache = root.path().join("cache/wow-ui-sim/lua-bytecode");
+        std::fs::create_dir_all(&cache).expect("create cache sentinel directory");
+        std::fs::write(
+            cache.join("pack.bin"),
+            b"untouched group-controller cache sentinel",
+        )
+        .expect("write cache sentinel");
+        let before = snapshot_cache_tree(&cache);
+        let pid_path = root.path().join("tree.pid");
+        let name = format!("group-contract::{group}::pass");
+        let output = group_controller_command(state, root.path())
+            .args([&name, "--exact"])
+            .env(GROUP_TIMEOUT_ENV, group)
+            .env(DRIVER_TIMEOUT_MS_ENV, "120")
+            .env(TREE_PID_ENV, &pid_path)
+            .output()
+            .expect("run timed out exact group controller");
+        assert_failure(&output);
+        assert!(stdout(&output).contains("FAILED (timeout after 120ms)"));
+        for path in [&pid_path, &pid_path.with_extension("parent")] {
+            let pid = std::fs::read_to_string(path)
+                .expect("read timed-out tree pid")
+                .trim()
+                .parse()
+                .expect("parse timed-out tree pid");
+            assert_process_disappears(pid);
+        }
+        let old_pid = group_setup_pid(root.path(), group);
+        assert_eq!(snapshot_cache_tree(&cache), before);
+        let fresh = group_controller_command(state, root.path())
+            .args([&name, "--exact"])
+            .output()
+            .expect("run fresh group after timeout");
+        assert_success(&fresh);
+        assert!(stdout(&fresh).contains(&format!("test {name} ... ok")));
+        assert_ne!(group_setup_pid(root.path(), group), old_pid);
+        assert_eq!(
+            snapshot_cache_tree(&cache),
+            before,
+            "timeout/fresh setup must not mutate disk cache"
+        );
+    }
+}
