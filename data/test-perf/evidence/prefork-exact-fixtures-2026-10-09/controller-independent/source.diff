+// Local conformance substitution only; normal fixture registries/constructors stay above.
+fn run_controller_fixture_group(group: &std::ffi::OsStr, config: Config) -> ExitCode {
+    let Some(group) = group
+        .to_str()
+        .filter(|group| CONTROLLER_GROUPS.contains(group))
+    else {
+        eprintln!("unsupported exact prefork fixture group");
+        return ExitCode::FAILURE;
+    };
+    let names = match group {
+        "chat" => ["group-contract::chat::pass", "group-contract::chat::other"],
+        "cast-bar" => [
+            "group-contract::cast-bar::pass",
+            "group-contract::cast-bar::other",
+        ],
+        "spellbook" => [
+            "group-contract::spellbook::pass",
+            "group-contract::spellbook::other",
+        ],
+        _ => unreachable!("enabled controller group must have deterministic cases"),
+    };
+    let cases = names.map(|name| Case::new(name, controller_fixture_child));
+    let config = Config {
+        timeout: duration_from_env(DRIVER_TIMEOUT_MS_ENV, 2_000),
+        ..config
+    };
+    run_exact_fixture(&cases, config, create_controller_fixture_env)
+}
+
