    {
      "id": "wt-global-api-GetAuctionItemInfo-4",
      "section": "global-api",
      "direction": "changed",
      "symbol": "GetAuctionItemInfo",
      "annotation": "* Two new returns (bidderFullName at #13 and ownerFullName at #15) have been added to {{api|GetAuctionItemInfo}}. Owner, previously #13, has been pushed to #14. Returns previously after owner (saleStatus, itemId, hasAllInfo) have been pushed forward by two places.",
      "wikitext_line": 4
    },
    {
      "id": "wt-global-api-GetLFGRoleUpdate-6",
      "section": "global-api",
      "direction": "changed",
      "symbol": "GetLFGRoleUpdate",
      "annotation": "*  One new return (bgQueue pushed from #4 to #5) have been added to {{api|GetLFGRoleUpdate}}.",
      "wikitext_line": 6
    },
    {
      "id": "wt-global-api-StartWarGame-8",
      "section": "global-api",
      "direction": "changed",
      "symbol": "StartWarGame",
      "annotation": "* {{api|StartWarGame}}(\"target\"[, area]) \"target\" unitid was unitName previously",
      "wikitext_line": 8
    },
    {
      "id": "wt-global-api-GetUnitName-11",
      "section": "global-api",
      "direction": "changed",
      "symbol": "GetUnitName",
      "annotation": "* {{api|GetUnitName}}(unitid[,showServer]) returns 'name-realm' instead of 'name - realm' (spaces removed) and most commands that accept a unitname now, work with 'name-server' format (/invite, /ginvite, /trade etc",
      "wikitext_line": 11
    },
