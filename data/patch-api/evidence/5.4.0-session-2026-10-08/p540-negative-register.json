    {
      "id": "wt-global-api-GetInstanceInfo-20",
      "section": "global-api",
      "direction": "changed",
      "symbol": "GetInstanceInfo",
      "annotation": "* A new return has been added to {{api|GetInstanceInfo}} - instanceGroupSize at #9 which gives the number of players that the raid's difficulty is tuned for (either the max players for normal raids, or the current number of players for flex raids)",
      "wikitext_line": 20
    },
    {
      "id": "wt-widgets-Slider:SetValueStep-23",
      "section": "widgets",
      "direction": "changed",
      "symbol": "Slider:SetValueStep",
      "annotation": "* [[Widget API#Slider|Slider]] widgets ignore the {{api|t=w|Slider:SetValueStep|valueStep}} property when {{api|t=w|Slider:SetStepsPerPage|stepsPerPage}} is not set.",
      "wikitext_line": 23
    },
    {
      "id": "wt-widgets-Slider:SetStepsPerPage-23",
      "section": "widgets",
      "direction": "changed",
      "symbol": "Slider:SetStepsPerPage",
      "annotation": "* [[Widget API#Slider|Slider]] widgets ignore the {{api|t=w|Slider:SetValueStep|valueStep}} property when {{api|t=w|Slider:SetStepsPerPage|stepsPerPage}} is not set.",
      "wikitext_line": 23
    },
    {
      "id": "wt-global-api-UnitRealmRelationship-26",
      "section": "global-api",
      "direction": "added",
      "symbol": "UnitRealmRelationship",
      "annotation": "* Players from [[Connected Realms]] (5.4 feature) can be interacted with in more ways (e.g. trading) than players from [[Coalesced Realms]] (old cross-realm zone functionality). {{api|UnitRealmRelationship}} returns information about another player's realm.",
      "wikitext_line": 26
    },
    {
      "id": "wt-events-SAVED_VARIABLES_TOO_LARGE-27",
      "section": "events",
      "direction": "added",
      "symbol": "SAVED_VARIABLES_TOO_LARGE",
      "annotation": "* A new error condition event, {{api|t=e|SAVED_VARIABLES_TOO_LARGE}}, was added which indicates that some, or all, of an AddOn's SavedVariables were not loaded due to the player's machine being out-of-memory. <ref name=\"blizz-SAVED_VARIABLES_TOO_LARGE\">http://us.battle.net/wow/en/forum/topic/9362996672</ref>",
      "wikitext_line": 27
    },
