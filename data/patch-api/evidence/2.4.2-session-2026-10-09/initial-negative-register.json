    {
      "id": "wt-global-api-CombatLogSetCurrentEntry-21",
      "section": "global-api",
      "direction": "changed",
      "symbol": "CombatLogSetCurrentEntry",
      "annotation": "* {{api|CombatLogSetCurrentEntry}}() behavior for negative and zero ids is shifted by 1 position. Newest is at 0 (was at -1), oldest is at <code>-CombatLogGetNumEntries() + 1</code> (was at -CombatLogGetNumEntries())",
      "wikitext_line": 21
