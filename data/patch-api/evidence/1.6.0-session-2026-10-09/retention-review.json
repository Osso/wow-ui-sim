  "environment_keys": [
    "BUILD_HOST_SCRIPTS",
    "CARGO_BUILD_JOBS",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
    "COLORTERM",
    "DBUS_SESSION_BUS_ADDRESS",
    "HOME",
    "INVOCATION_ID",
    "LC_CTYPE",
    "LOGNAME",
    "MAIL",
    "MOTD_SHOWN",
    "NoDefaultCurrentDirectoryInExePath",
    "PATH",
    "PI_CODING_AGENT",
