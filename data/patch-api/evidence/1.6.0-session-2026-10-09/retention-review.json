  "sensitive_key_pattern": "token|secret|password|credential|api.?key",
  "sensitive_key_name_matches": [],
  "environment_values_retained": false,
  "value_patterns": [
    "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
    "(?i)Bearer\\s+[A-Za-z0-9._-]{16,}",
    "\\bsk-[A-Za-z0-9_-]{20,}",
    "\\bgh[pousr]_[A-Za-z0-9]{20,}",
    "(?i)(?:password|api_key|access_token)\\s*[:=]\\s*[\\\"\\'][^\\\"\\']{8,}[\\\"\\']"
  ],
  "artifact_matches": [],
  "scope": "all own evidence text before original sealing; detector literals excluded from future self-scan",
  "limit": "not exhaustive secret detection; full command streams unaltered"
}
